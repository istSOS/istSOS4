# istSOS4 (source)
ISTSOS4_FROM_URL=https://source.example/v1.1
ISTSOS4_FROM_USER=source-user
ISTSOS4_FROM_PASSWORD=source-password

# Optional source filters
NETWORK_FROM=
DATASTREAMS_FROM=
TIMESTAMP_START_FROM=
TIMESTAMP_END_FROM=

# istSOS4 (target)
ISTSOS4_TO_URL=http://target.example/v1.1
ISTSOS4_TO_USER=target-user
ISTSOS4_TO_PASSWORD=target-password

# Optional target filters
NETWORK_TO=
DATASTREAMS_TO=

# "No data" handling
# IMPORT_NODATA=true  -> import everything (default)
# IMPORT_NODATA=false -> drop observations whose result equals NODATA_VALUE
IMPORT_NODATA=true
NODATA_VALUE=-999.9

# Log verbosity: DEBUG, INFO (default), WARNING, ERROR
LOG_LEVEL=INFO
