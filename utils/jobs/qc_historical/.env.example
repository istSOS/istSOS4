ISTSOS4_URL=http://localhost:8018/v4/v1.1
ISTSOS4_USERNAME=qc1
ISTSOS4_PASSWORD=qwertz

# Admin/editor/obs_manager users need a commit message for QC updates.
# With one account, this message is also used when filling gaps.
# Leave empty for a qc user (QC only).
COMMIT_MESSAGE=

# Check the observations whose phenomenonTime is in this range (ISO 8601,
# UTC when no offset, bounds included). Empty = all observations.
# PERIOD=2025-09-01T00:00:00Z,2025-09-05T23:59:59Z
# PERIOD=2025-09-01T00:00:00Z,   -> from that date
# PERIOD=,2025-09-05T23:59:59Z   -> up to that date
PERIOD=

# Datastream names as in istSOS. Only datastreams with constraints are
# checked anyway. Empty = all / none excluded.
# DATASTREAMS=datastream1,datastream2
DATASTREAMS=
EXCLUDE_DATASTREAMS=

# Create missing observations using properties.samplingFrequency (e.g. PT10M).
# New observations have result=999.9 and resultQuality="0". Only PERIOD is filled;
# empty bounds use the first/last existing observations in the selected period.
FILL_MISSING=false

# Optional separate insert credentials; empty = reuse the main account.
# Needed only when the main account cannot insert (e.g. the qc role).
# A separate sensor user needs no message. A separate admin/editor/obs_manager
# user needs FILL_COMMIT_MESSAGE. Otherwise filling uses COMMIT_MESSAGE.
ISTSOS4_FILL_USERNAME=
ISTSOS4_FILL_PASSWORD=
FILL_COMMIT_MESSAGE=
