# Check the observations whose phenomenonTime is in this range (ISO 8601,
# UTC when no offset, bounds included). Empty = all observations.
# PERIOD=2025-09-01T00:00:00Z,2025-09-05T23:59:59Z
# PERIOD=2025-09-01T00:00:00Z,   -> from that date
# PERIOD=,2025-09-05T23:59:59Z   -> up to that date
PERIOD=

# Datastream names as in istSOS. Only datastreams with constraints are
# checked anyway. Empty = all / none excluded.
# DATASTREAMS=datastream1,datastream2
DATASTREAMS=
EXCLUDE_DATASTREAMS=
