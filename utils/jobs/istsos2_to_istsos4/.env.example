# istSOS2 (source)
ISTSOS2_URL=https://source.example/istsos2
ISTSOS2_USER=source-user
ISTSOS2_PASSWORD=source-password

# istSOS4 (target)
ISTSOS4_URL=http://localhost:8019/v4/v1.1
ISTSOS4_USER=target-user
ISTSOS4_PASSWORD=target-password

# "No data" handling
# IMPORT_NODATA=true  -> import everything (default)
# IMPORT_NODATA=false -> drop observations whose result equals NODATA_VALUE
IMPORT_NODATA=true
NODATA_VALUE=-999.9

# Log verbosity: DEBUG, INFO (default), WARNING, ERROR
LOG_LEVEL=INFO