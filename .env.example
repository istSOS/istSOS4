# This file contains environment variables for the istsos4 project.

# HOSTNAME: The hostname of the server where the istsos4 project is running.
#           Default: http://localhost:8018
#           Note: The port should match the EXTERNAL_PORT variable.
HOSTNAME=http://localhost:8018

# EXTERNAL_PORT: The external port on which the istSOS server is accessible.
#                Default: 8018
EXTERNAL_PORT=8018

# SUBPATH: The subpath of the istSOS server.
#          Default: /istsos4
SUBPATH=/istsos4

# VERSION: The version of the istSOS offered STA.
#          Default: /v1.1
VERSION=/v1.1

# DEBUG: Enable or disable debug mode.
#        0 - disabled
#        1 - enabled
#        Default: 0
DEBUG=0

# VERSIONING: Enable or disable versioning of data.
#             0 - disabled
#             1 - enabled
#             Default: 0
VERSIONING=0

# POSTGRES_DB: The name of the PostgreSQL database used by istSOS.
#              Default: istsos
POSTGRES_DB=istsos

# POSTGRES_USER: The username for connecting to the PostgreSQL database.
#                Default: postgres
POSTGRES_USER=postgres

# POSTGRES_PASSWORD: The password for connecting to the PostgreSQL database.
#                    Default: postgres
POSTGRES_PASSWORD=postgres

# POSTGRES_HOST: Specifies the hostname of the PostgreSQL database server.
#                Default: database
POSTGRES_HOST=database

# POSTGRES_EXTERNAL_PORT: The external port for the PostgreSQL database.
#                         Default: 45432
POSTGRES_EXTERNAL_PORT=45432

# ISTSOS_ADMIN: The username for the istSOS administrator.
#               Default: admin
ISTSOS_ADMIN=admin

# ISTSOS_ADMIN_PASSWORD: The password for the istSOS administrator.
#                        Default: admin
ISTSOS_ADMIN_PASSWORD=admin

# PG_MAX_OVERFLOW: The maximum number of connections that can be opened above the maximum number of connections specified by PG_MAX_CONNECTIONS.
#                  Default: 0
PG_MAX_OVERFLOW=0

# PG_POOL_SIZE: The maximum number of connections to the PostgreSQL database pool.
#                Default: 10
PG_POOL_SIZE=10

# PG_POOL_TIMEOUT: The maximum time in seconds that a client can wait for a connection from the connection pool.
#                   Default: 30
PG_POOL_TIMEOUT=30

# DUMMY_DATA: Set to 1 if you want to use dummy data for testing purposes.
#             0 - disabled
#             1 - enabled
#             Default: 1
DUMMY_DATA=0

# CLEAR_DATA: Set to 1 if you want to clear existing data before running the program.
#             0 - disabled
#             1 - enabled
#             Default: 0
CLEAR_DATA=0

# N_THINGS: Number of things to generate data for.
#           Default: 10
N_THINGS=5

# N_OBSERVED_PROPERTIES: Number of observed properties to generate data for.
#                        Default: 2
N_OBSERVED_PROPERTIES=4

# INTERVAL: Interval for generating data.
#           Default: P1Y (1 year)
INTERVAL=P7D

# FREQUENCY: Frequency of data generation.
#            Default: PT5M (every 5 minutes)
FREQUENCY=PT5M

# START_DATETIME: The start date for phenomenonTime of observation.
#                 Format: YYYY-MM-DDTHH:MM:SS.SSS+HH:MM
#                 Default: 2020-01-01T12:00:00.000+01:00
START_DATETIME=2020-01-01T12:00:00.000+01:00

# CHUNK_INTERVAL: The interval for chunking data.
#                 Default: P1Y (1 year)
CHUNK_INTERVAL=P7D

# COUNT_MODE: Specifies the count mode for estimation.
#             FULL - Fully count all entities. Can be very slow on large result sets, but always gives accurate results.
#             LIMIT_ESTIMATE - First do a count, with a limit of countEstimateThreshold. If the limit is reached, do an
#                              estimate using EXPLAIN. For large result can be wildly inaccurate for fields that are not backed by an index.
#                              For low counts this method is still guaranteed to give accurate results.
#             ESTIMATE_LIMIT - First do an estimate using EXPLAIN and if the estimate is below the threshold, do a count with
#                              a limit of countEstimateThreshold. This is the fastest method, but if the estimate is inaccurate,
#                              it can give an incorrect estimate for low counts.
#             Default: FULL
COUNT_MODE=FULL

# COUNT_ESTIMATE_THRESHOLD: Specifies the threshold for count estimation.
#                           Default: 10000
COUNT_ESTIMATE_THRESHOLD=10000

# TOP_VALUE: Specifies the default top value.
#            Default: 100
TOP_VALUE=100

# PARTITION_CHUNK: Determines the number of records to be processed in each partition.
#                  Default: 10000
PARTITION_CHUNK=10000

# REDIS: Indicates whether Redis is enabled.
#        0 - disabled
#        1 - enabled
#        Default: 0
REDIS=0

# DUPLICATES: Indicates whether duplicate entries are allowed.
#             0 - disabled
#             1 - enabled
#             Default: 0
DUPLICATES=1

# EPSG: Specifies the coordinate reference system to be used.
#       Default: 4326
EPSG=4326

# AUTHORIZATION: Specifies the authorization level.
#                0 - disabled
#                1 - enabled
#                Default: 0
AUTHORIZATION=0

# SECRET_KEY: A secret key used for encoding tokens generated with 'openssl rand -hex 32'.
#             Default: 09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7

# ALGORITHM: The algorithm used for encoding tokens.
#            Default: HS256
ALGORITHM=HS256

# ACCESS_TOKEN_EXPIRE_MINUTES: The expiration time for access tokens in minutes.
#                              Default: 5
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ANONYMOUS_VIEWER: Indicates whether anonymous viewer is enabled.
#                   0 - disabled
#                   1 - enabled
ANONYMOUS_VIEWER=0

# NETWORK: Indicates whether network access is enabled.
#          0 - disabled
#          1 - enabled
NETWORK=0

# ST_AGGREGATE: Specifies the function for updating the observedArea of datastreams
#               CONVEX_HULL - A convex hull is used to determine an affected area based on a aggregate set of geometries based on their sets of point observations.
#               EXTENT - a two-dimensional bounding box enclosing a geometry or collection of geometries is used instead.
#               Default: CONVEX_HULL
ST_AGGREGATE=CONVEX_HULL

# LOG_LEVEL: Python logging level for the API (DEBUG, INFO, WARNING, ERROR).
#            Default: INFO
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Metadata connector (STAC 1.0 and DCAT-AP 3.0)
# Served under {HOSTNAME}{SUBPATH}{VERSION}/connector, see
# api/app/v1/connector/README.md
# ---------------------------------------------------------------------------

# STAC_TRANSFORMER: Publish the STAC 1.0 catalog under /connector/stac.
#                   0 - disabled (routes return 404, nothing is harvested for STAC)
#                   1 - enabled
#                   Default: 0
STAC_TRANSFORMER=0

# DCAT_TRANSFORMER: Publish the DCAT-AP 3.0 catalog under /connector/dcat.
#                   Needs DCAT_CATALOG_TITLE, DCAT_CATALOG_DESCRIPTION and DCAT_PUBLISHER_NAME.
#                   0 - disabled (routes return 404, nothing is harvested for DCAT)
#                   1 - enabled
#                   Default: 0
DCAT_TRANSFORMER=0

# HARVEST_INTERVAL_MINUTES: Minutes between connector harvest cycles. The first
#                           cycle runs right after the API starts.
#                           Default: 15
HARVEST_INTERVAL_MINUTES=15

# OPEN_CATALOG_METADATA: With AUTHORIZATION=1 and ANONYMOUS_VIEWER=0, whether
#                        anonymous callers can read the connector catalogs.
#                        0 - login required (401)
#                        1 - public
#                        Default: 1
OPEN_CATALOG_METADATA=1

# CATALOG_CLOSED_NETWORKS: Comma-separated Network ids and/or names hidden from
#                          anonymous callers (404, so their existence is not leaked)
#                          and listed only for logged-in users. Names must match
#                          sensorthings."Network".name exactly, e.g. 3,Rain Gauges
#                          Only applies with NETWORK=1, AUTHORIZATION=1 and ANONYMOUS_VIEWER=0.
#                          Default: empty
CATALOG_CLOSED_NETWORKS=

# STAC_CATALOG_ID: id of the root STAC Catalog.
#                  Default: istsos-connector-catalog
STAC_CATALOG_ID=istsos-connector-catalog

# STAC_CATALOG_TITLE: Title of the root STAC Catalog.
#                     Default: empty (no title)
STAC_CATALOG_TITLE=istSOS4 STAC Catalog

# STAC_DEPLOYMENT_NAME: Deployment name used in generated STAC descriptions.
#                       Default: istSOS4
STAC_DEPLOYMENT_NAME=istSOS4

# STAC_DEFAULT_LICENSE: Collection license when a Thing has no "license" property.
#                       An SPDX id (e.g. CC-BY-4.0), various or proprietary.
#                       Default: proprietary
STAC_DEFAULT_LICENSE=proprietary

# STAC_AUTH_DESCRIPTION: Text shown to STAC clients on how to get a token when
#                        assets need one (AUTHORIZATION=1, ANONYMOUS_VIEWER=0).
#                        Default: points at the istSOS Login endpoint
STAC_AUTH_DESCRIPTION=

# DCAT_CATALOG_ID: dct:identifier of the root dcat:Catalog.
#                  Default: istsos-connector-dcat-catalog
DCAT_CATALOG_ID=istsos-connector-dcat-catalog

# DCAT_CATALOG_TITLE: dct:title of the root dcat:Catalog. Required for DCAT.
DCAT_CATALOG_TITLE=istSOS4 DCAT Catalog

# DCAT_CATALOG_DESCRIPTION: dct:description of the root dcat:Catalog. Required for DCAT.
DCAT_CATALOG_DESCRIPTION=Sensor metadata published by istSOS4

# DCAT_PUBLISHER_NAME: foaf:name of the publishing organization. Required for DCAT.
DCAT_PUBLISHER_NAME=istSOS4

# DCAT_PUBLISHER_URI: URI of the publisher. If empty the publisher is a blank node.
DCAT_PUBLISHER_URI=https://istsos.org

# DCAT_PUBLISHER_HOMEPAGE: Homepage of the publisher.
DCAT_PUBLISHER_HOMEPAGE=https://istsos.org

# DCAT_PUBLISHER_MBOX: Contact email of the publisher.
DCAT_PUBLISHER_MBOX=

# DCAT_GEOMETRY_ENCODING: How dct:spatial geometries are written.
#   node    (default) locn:geometry -> locn:Geometry node, as the DCAT-AP 3.0 shapes require
#   bbox    dcat:bbox + dcat:centroid WKT literals; conforms and is harvestable by CKAN (ckanext-dcat)
#   literal locn:geometry as a GeoJSON literal; harvestable by CKAN, violates one DCAT-AP shape
DCAT_GEOMETRY_ENCODING=node

# DCAT_DEPLOYMENT_NAME: Deployment name used in generated DCAT descriptions.
#                       Default: istSOS4
DCAT_DEPLOYMENT_NAME=istSOS4

# DCAT_LANGUAGE: Language tag for DCAT literals (en, it, de, fr, es).
#                Default: en
DCAT_LANGUAGE=en

# DCAT_DEFAULT_LICENSE: dct:license when a Datastream has no "license" property.
#                       An SPDX id (e.g. CC-BY-4.0) or a license URI.
#                       Default: empty (no license emitted)
DCAT_DEFAULT_LICENSE=CC-BY-4.0

# DCAT_DEFAULT_ACCESS_RIGHTS: dct:accessRights URI when a Datastream has no
#                             "accessRights" property.
#                             Default: empty (no access rights emitted)
DCAT_DEFAULT_ACCESS_RIGHTS=http://publications.europa.eu/resource/authority/access-right/PUBLIC
